namespace hammer {
  // Mirrors the gomobile-generated `HammerSetup(opts, &err)` global. Rust runtime
  // does not need basePath/tempPath, so the call is a no-op aside from accepting
  // the options dictionary; kept for drop-in compatibility with the legacy SDK.
  [Throws=HammerError]
  void hammer_setup(HammerSetupOptions options);

  [Throws=HammerError]
  void hammer_check_config(string content);

  [Throws=HammerError]
  string hammer_format_config(string content);

  [Throws=HammerError]
  HammerService hammer_new_service(string config_content, HammerPlatform platform);

  // gomobile shipped a global helper that scanned the process for a utun fd.
  // Rust keeps the same fallback on Apple platforms for hosts where
  // NEPacketTunnelFlow does not expose a stable KVC fd path.
  i32 hammer_get_tunnel_file_descriptor();
};

[Error]
interface HammerError {
  ConfigParse(string message);
  ConfigValidation(string message);
  PlatformMissing();
  ServiceClosed();
  ServiceAlreadyStarted();
  Lifecycle(string stage, string message);
  Platform(string message);
  Tcp(string message);
  Internal(string message);
};

dictionary HammerSetupOptions {
  string base_path;
  string temp_path;
  boolean debug;
};

dictionary HammerTunOptions {
  string name;
  i32 mtu;
  sequence<string> address;
  sequence<string> route;
  sequence<string> route_exclude;
  boolean auto_route;
  boolean strict_route;
  boolean tap;
};

dictionary HammerNetworkInterface {
  i32 index;
  i32 mtu;
  string name;
  i32 type_;
  i32 flags;
  boolean expensive;
  boolean constrained;
  sequence<string> addresses;
};

dictionary HammerWIFIState {
  string ssid;
  string bssid;
};

callback interface HammerStringIterator {
  boolean has_next();
  string next();
};

callback interface HammerNetworkInterfaceIterator {
  boolean has_next();
  HammerNetworkInterface? next();
};

interface HammerDefaultInterfaceUpdateListener {
  void update_default_interface(string name, i32 interface_index, boolean is_expensive, boolean is_constrained);
};

callback interface HammerPlatform {
  [Throws=HammerError]
  i32 open_tun(HammerTunOptions options);

  boolean use_platform_auto_detect_interface_control();

  [Throws=HammerError]
  void auto_detect_interface_control(i32 fd);

  [Throws=HammerError]
  void start_default_interface_monitor(HammerDefaultInterfaceUpdateListener listener);

  [Throws=HammerError]
  void close_default_interface_monitor(HammerDefaultInterfaceUpdateListener listener);

  [Throws=HammerError]
  HammerNetworkInterfaceIterator get_interfaces();

  boolean under_network_extension();
  boolean include_all_networks();
  HammerWIFIState? read_wifi_state();
  HammerStringIterator? system_certificates();
  void write_log(i32 level, string message);
};

interface HammerService {
  [Throws=HammerError]
  void start();

  [Throws=HammerError]
  void close();

  void pause();
  void wake();
  void reset_network();
  boolean need_wifi_state();
  void update_wifi_state();

  // V1 protocol must be "icmp"; per-outbound timeout.
  // Order of returned reports matches the configured outbound list.
  [Throws=HammerError]
  sequence<HammerProbeReport> probe_outbounds(
    string protocol,
    u64 timeout_ms
  );

  sequence<HammerMetricSample> metrics();
};

dictionary HammerProbeReport {
  string outbound_id;
  string protocol;
  boolean ok;
  u64 latency_ms;
  string error;
};

dictionary HammerMetricLabel {
  string key;
  string value;
};

dictionary HammerMetricSample {
  string module;
  string component_type;
  string component_id;
  string name;
  string kind;
  u64 value;
  sequence<HammerMetricLabel> labels;
};
