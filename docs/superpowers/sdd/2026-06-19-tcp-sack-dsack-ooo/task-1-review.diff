+
+    fn internet_checksum(bytes: &[u8]) -> u16 {
+        let mut sum = 0u32;
+        for chunk in bytes.chunks(2) {
+            let word = match chunk {
+                [hi, lo] => u16::from_be_bytes([*hi, *lo]) as u32,
+                [hi] => u16::from_be_bytes([*hi, 0]) as u32,
+                _ => unreachable!(),
+            };
+            sum += word;
+            while sum > 0xffff {
+                sum = (sum & 0xffff) + (sum >> 16);
+            }
+        }
+        !(sum as u16)
+    }
+}
