+impl SessionTransport<Index, Local> for QuicShapedTransport {
+    type Tx = TransportInternalTx;
+
+    const ID: SessionTransportId = SessionTransportId::new(7);
+
+    fn update_time(
+        &mut self,
+        _: &mut SessionWorker<Index, Local>,
+        _: &DataPlaneRuntime,
+        _: SessionQueueNext,
+        _: &mut super::SessionQueueOutput,
+        _: Instant,
+    ) -> CoreResult<()> {
+        Ok(())
+    }
+
+    fn disconnect(
+        &mut self,
+        _: &mut SessionWorker<Index, Local>,
+        _: Index,
+        _: &DataPlaneRuntime,
+        _: SessionQueueNext,
