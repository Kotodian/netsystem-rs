+    fn new(packets: Arc<Mutex<Vec<Vec<u8>>>>) -> Self {
+        let mut states = payload_capture_states()
+            .lock()
+            .expect("payload capture states");
+        let slot = states.len();
+        states.push(packets);
+        Self {
+            runtime_data: NodeRuntimeData::from_usize(slot).expect("payload capture slot"),
+        }
+    }
+}
